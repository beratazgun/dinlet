# Redis (NestJS API ile aynı; BullMQ kuyrukları)
REDIS_HOST=dinlet-redis
REDIS_PORT=6379
REDIS_PASSWORD=
# REDIS_URL verilirse yukarıdakilerin yerine kullanılır
# REDIS_URL=redis://:sifre@dinlet-redis:6379
QUEUE_PREFIX=bull

# Cloudflare R2 (S3 uyumlu) — API ile aynı bucket
R2_ENDPOINT=http://dinlet-localstack:4566
R2_ACCESS_KEY_ID=test
R2_SECRET_ACCESS_KEY=test
R2_BUCKET_NAME=dinlet-bucket

# Performans (benchmark'a göre ayarlanır)
TORCH_THREADS=1
# oneDNN çekirdekleri: auto (arm64'te kapalı) | on | off
TORCH_MKLDNN=auto
LOCK_DURATION_MS=120000

# Ses
MP3_BITRATE=48k
TITLE_PAUSE_MS=800
PARAGRAPH_PAUSE_MS=600
RECAP_PAUSE_MS=1200
