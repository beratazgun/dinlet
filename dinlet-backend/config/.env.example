
# NODE_ENV
NODE_ENV=development

APP_NAME=Dinlet

# POSGRES CONNECTION
DATABASE_URL="postgresql://dinlet-user:dinlet-pass@dinlet-postgres:5432/dinlet-db?connection_limit=20&pool_timeout=10"

# PORTS
PORT=3000

# REQUEST
# İstek zaman aşımı (ms). Verilmezse 10000 (10sn) kullanılır.
REQUEST_TIMEOUT_MS=10000

# DOMAINS
SERVICE_DOMAIN='http://localhost:3000'
FRONTEND_URL='http://localhost:3001'
# Mobil uygulamanın URL şeması (onay bağlantısı uygulamayı açar)
APP_DEEP_LINK_SCHEME=dinletapp

# Seed kullanıcıları (pnpm db:seed). Production'da yalnızca süper admin oluşur;
# parola en az 16 karakter, e-posta zorunlu.
SEED_USER_PASSWORD=
SEED_ADMIN_EMAIL=

# Session (@fastify/session)
# Cookie imzalama anahtarı — en az 32 karakter olmak zorunda.
SESSION_SECRET=session-secret-key-change-in-production-min-32-chars
SESSION_COOKIE_NAME=sid
# Oturum ömrü (saniye). rolling:true olduğu için her istekte sıfırlanır.
SESSION_MAX_AGE=604800 # 7 gün | 1 gün = 86400 | 12 saat = 43200
# Mobil (Bearer) oturum ömrü (saniye)
SESSION_MAX_AGE_MOBILE=2592000 # 30 gün

# AWS
R2_ACCESS_KEY_ID=test
R2_SECRET_ACCESS_KEY=test
R2_ACCOUNT_ID=000000000000
R2_BUCKET_NAME=dinlet-bucket
# NestJS Docker'da → localstack hostname'i kullanır
R2_ENDPOINT=http://dinlet-localstack:4566
# Browser'a sunulan presigned URL'leri için → localhost'tan çözülür
R2_PUBLIC_ENDPOINT=http://localhost:4566
R2_CDN_BASE_URL=http://localhost:4566/dinlet-bucket
MAX_MEDIA_SIZE=31457280 # 30MB

# E-posta teslimi: send (varsayılan) | log (gönderme, yalnızca logla — test/yerel)
EMAIL_DELIVERY=send

# Expo Push: send (varsayılan) | log (gönderme, yalnızca logla — test/yerel)
PUSH_DELIVERY=send
EXPO_ACCESS_TOKEN=

# BREVO (primary email provider)
BREVO_API_KEY=
BREVO_FROM_EMAIL=
BREVO_FROM_NAME=
BREVO_MAIL_FOR_DEV_ENV=

# RESEND
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_MAIL_FOR_DEV_ENV=

# Google Sign-In (mobil) — idToken `aud` doğrulaması için client ID'ler (virgülle)
GOOGLE_CLIENT_IDS=
# Sign in with Apple — identityToken `aud` doğrulaması için bundle ID'ler (virgülle)
APPLE_CLIENT_IDS=

# LLM sağlayıcı zinciri (Pro planda akıcı anlatım). Sırayla denenir; kotası
# biten/hata veren sağlayıcıdan sonrakine geçilir. Anahtarı boş olan zincirden
# düşer; hepsi boşsa notlar LLM'siz (kural tabanlı) işlenir.
LLM_PROVIDER_CHAIN=gemini,mistral,anthropic

GEMINI_API_KEY=
GEMINI_LLM_MODELS=gemini-flash-lite-latest,gemini-2.5-flash-lite,gemini-flash-latest,gemini-2.5-flash

MISTRAL_API_KEY=
MISTRAL_LLM_MODELS=mistral-small-latest,mistral-medium-latest

ANTHROPIC_API_KEY=
ANTHROPIC_LLM_MODELS=claude-haiku-5-5
# Yalnızca Claude: low | medium | high | xhigh | max
LLM_EFFORT=low

# Kota (429) dolan model bu kadar saniye dinlenir (sağlayıcı süre bildirmezse)
LLM_QUOTA_COOLDOWN_SECONDS=60
LLM_MAX_TOKENS=16000
LLM_CONCURRENCY=3

# RevenueCat (abonelik)
REVENUECAT_WEBHOOK_AUTH=
REVENUECAT_API_KEY=
REVENUECAT_PRO_ENTITLEMENT=pro

# Kuyruk alarmları (DLQ, tts'te uzun bekleme) için e-posta. Boşsa kapalı.
ALERT_EMAIL=

# Redis connection
REDIS_HOST="redis"
REDIS_PORT="6379"
REDIS_PASSWORD=""  # Zorunlu değil

# NestJS Observe (https://observe.nestjs.com) — ikisi de doluysa açılır, boşsa kapalı.
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=
# Panelde servis adı (boşsa APP_NAME)
OBSERVE_SERVICE_ID=
# Gönderilecek trace oranı 0–1 (boşsa 1)
OBSERVE_TRACES_SAMPLE_RATE=

# KVKK metinlerindeki veri sorumlusu (unvan, adres, başvuru e-postası)
LEGAL_CONTROLLER_NAME=
LEGAL_CONTROLLER_ADDRESS=
LEGAL_CONTACT_EMAIL=
