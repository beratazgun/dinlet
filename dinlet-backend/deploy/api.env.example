# Dokploy → dinlet-api (Application) → Environment

NODE_ENV=production
APP_NAME=Dinlet
PORT=3000
SERVICE_DOMAIN=https://api.dinlet.app
FRONTEND_URL=https://dinlet.app
# Mobil uygulamanın URL şeması (onay bağlantısı uygulamayı açar)
APP_DEEP_LINK_SCHEME=dinletapp

# Dokploy veritabanlarının "Internal Connection" bilgileri
DATABASE_URL=postgresql://<user>:<parola>@<dinlet-postgres-iç-adı>:5432/dinlet
REDIS_HOST=<dinlet-redis-iç-adı>
REDIS_PORT=6379
REDIS_PASSWORD=

# Açılışta bekleyen migration'ları uygula (varsayılan true)
RUN_MIGRATIONS=true

# Oturum
SESSION_SECRET=
SESSION_COOKIE_NAME=sid
SESSION_MAX_AGE=604800
SESSION_MAX_AGE_MOBILE=2592000

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=dinlet
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_PUBLIC_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_CDN_BASE_URL=https://audio.dinlet.app
MAX_MEDIA_SIZE=31457280

# Mobil giriş
GOOGLE_CLIENT_IDS=
APPLE_CLIENT_IDS=

# LLM zinciri (Pro): sırayla denenir, kota biterse sonrakine geçilir
LLM_PROVIDER_CHAIN=gemini,mistral,anthropic
GEMINI_API_KEY=
GEMINI_LLM_MODELS=gemini-flash-lite-latest,gemini-2.5-flash-lite,gemini-flash-latest,gemini-2.5-flash
MISTRAL_API_KEY=
MISTRAL_LLM_MODELS=mistral-small-latest,mistral-medium-latest
ANTHROPIC_API_KEY=
ANTHROPIC_LLM_MODELS=claude-haiku-5-5
LLM_EFFORT=low
LLM_QUOTA_COOLDOWN_SECONDS=60

# Abonelik
REVENUECAT_WEBHOOK_AUTH=
REVENUECAT_API_KEY=
REVENUECAT_PRO_ENTITLEMENT=pro

# Bildirim ve e-posta
PUSH_DELIVERY=send
EXPO_ACCESS_TOKEN=
EMAIL_DELIVERY=send
BREVO_API_KEY=
BREVO_FROM_EMAIL=
BREVO_FROM_NAME=Dinlet
RESEND_API_KEY=
RESEND_FROM_EMAIL=
ALERT_EMAIL=

# İlk kurulum seed'i (npm run db:seed:prod): yalnızca süper yönetici oluşur
SEED_USER_PASSWORD=
SEED_ADMIN_EMAIL=

# KVKK metinlerindeki veri sorumlusu (unvan, adres, başvuru e-postası)
LEGAL_CONTROLLER_NAME=
LEGAL_CONTROLLER_ADDRESS=
LEGAL_CONTACT_EMAIL=
