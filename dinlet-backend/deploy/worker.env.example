# Dokploy → dinlet-tts (Application) → Environment

REDIS_HOST=<dinlet-redis-iç-adı>
REDIS_PORT=6379
REDIS_PASSWORD=
QUEUE_PREFIX=bull

# API ile aynı R2 bucket'ı
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=dinlet

TORCH_THREADS=1
TORCH_MKLDNN=auto
LOCK_DURATION_MS=120000
MP3_BITRATE=48k
