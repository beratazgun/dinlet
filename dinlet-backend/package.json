{
  "name": "nestjs-12-dinlet-session",
  "private": true,
  "version": "0.0.1",
  "description": "",
  "author": "berat",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24",
    "pnpm": ">=10"
  },
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json --resolve-full-paths --resolve-full-extension .js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "NODE_OPTIONS=--conditions=compiled nest start",
    "start:dev": "NODE_OPTIONS=--conditions=compiled nest start --watch",
    "start:debug": "NODE_OPTIONS=--conditions=compiled nest start --debug --watch",
    "start:prod": "node --conditions=compiled dist/src/main.js",
    "lint": "oxlint src --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "contract:emit": "prisma contract emit",
    "db:init": "prisma db init",
    "db:reset": "tsx scripts/db-reset.ts && prisma db update && pnpm db:seed",
    "db:seed": "tsx src/infra/database/seed/main.ts",
    "db:seed:prod": "node --conditions=compiled dist/src/infra/database/seed/main.js",
    "db:update": "prisma db update",
    "db:verify": "prisma db verify",
    "db:push": "prisma contract emit && prisma db update",
    "dev": "tsx watch src/main.ts",
    "migrate": "prisma db migrate",
    "migration:plan": "prisma migration plan",
    "migration:show": "prisma migration show",
    "migration:status": "prisma migration status",
    "skills:sync": "prisma skills sync || exit 0",
    "prepare": "husky"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.132.0",
    "@aws-sdk/client-s3": "^3.1140.0",
    "@aws-sdk/s3-request-presigner": "^3.1140.0",
    "@bull-board/api": "^9.10.4",
    "@bull-board/fastify": "^9.10.4",
    "@casl/ability": "^7.0.1",
    "@casl/prisma": "^2.0.2",
    "@fastify/compress": "^9.2.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/multipart": "^10.1.2",
    "@fastify/session": "^11.1.3",
    "@fastify/static": "^10.1.4",
    "@getbrevo/brevo": "^6.0.3",
    "@nest-lab/throttler-storage-redis": "^1.2.0",
    "@nestjs/bullmq": "^12.0.0",
    "@nestjs/common": "^12.1.0",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.0",
    "@nestjs/event-emitter": "^12.0.1",
    "@nestjs/observe": "0.3.6",
    "@nestjs/platform-express": "^12.1.0",
    "@nestjs/platform-fastify": "^12.1.0",
    "@nestjs/platform-socket.io": "^12.1.0",
    "@nestjs/schedule": "^12.0.2",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/websockets": "^12.1.0",
    "@prisma/cli-engine": "^0.3.0",
    "@prisma/orm-postgres": "8.0.0-rc.8",
    "@socket.io/redis-adapter": "^8.3.0",
    "@types/qs": "^6.15.1",
    "argon2": "^0.45.1",
    "bullmq": "^5.81.5",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cli-color": "^2.0.4",
    "cron": "^4.4.0",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.5",
    "google-auth-library": "^11.1.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.12",
    "nanoid": "^6.0.1",
    "pdf-lib": "^1.17.1",
    "prisma": "8.0.0-rc.12",
    "qs": "^6.16.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-email": "6.9.3",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.29.0",
    "rxjs": "^7.8.2",
    "slugify": "^1.6.9",
    "socket.io": "4.8.3",
    "temporal-polyfill": "^1.0.5"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@nestjs/cli": "^12.0.7",
    "@nestjs/testing": "^12.1.0",
    "@types/cli-color": "^2.0.6",
    "@types/node": "^25.9.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "oxlint": "^1.85.0",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.9",
    "rimraf": "^6.1.3",
    "socket.io-client": "4.8.3",
    "tsc-alias": "^1.9.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "lint-staged": {
    "*.{ts,tsx}": "oxlint --fix",
    "*.{json,md,yml,yaml}": "prettier --write"
  },
  "imports": {
    "#database/*.js": {
      "compiled": "./dist/src/infra/database/*.js",
      "default": "./src/infra/database/*.ts"
    },
    "#root/*.js": {
      "compiled": "./dist/*.js",
      "default": "./*.ts"
    },
    "#config/*.js": {
      "compiled": "./dist/config/*.js",
      "default": "./config/*.ts"
    },
    "#/*": {
      "compiled": "./dist/src/*",
      "default": "./src/*"
    },
    "#root/*": {
      "compiled": "./dist/*",
      "default": "./*"
    },
    "#config/*": {
      "compiled": "./dist/config/*",
      "default": "./config/*"
    },
    "#database/*": {
      "compiled": "./dist/src/infra/database/*",
      "default": "./src/infra/database/*"
    }
  }
}
