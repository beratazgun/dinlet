        "sql": "CREATE TABLE \"public\".\"mnemonics\" (\n  \"audio_key\" text,\n  \"created_at\" timestamptz DEFAULT (now()) NOT NULL,\n  \"dismissed\" bool DEFAULT false NOT NULL,\n  \"document_id\" int4 NOT NULL,\n  \"duration_ms\" int4,\n  \"explanation\" text NOT NULL,\n  \"hook\" text NOT NULL,\n  \"id\" SERIAL NOT NULL,\n  \"kept\" bool DEFAULT false NOT NULL,\n  \"position\" int4 DEFAULT 0 NOT NULL,\n  \"section_id\" int4,\n  \"topic\" text NOT NULL,\n  \"updated_at\" timestamptz NOT NULL,\n  PRIMARY KEY (\"id\")\n)",
