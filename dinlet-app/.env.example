# Backend API kökü (sonunda /api/v1). Gerçek cihazda localhost yerine
# bilgisayarın yerel IP'si yazılır.
EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1

# Google Sign-In (Google Cloud → Credentials → OAuth client ID).
# Web client ID, backend'in GOOGLE_CLIENT_IDS listesinde olmalı: idToken'ın
# audience'ı odur.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

